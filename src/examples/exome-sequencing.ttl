# Collecting a specimen from a patient in a biobank encounter, extracting DNA from it,
# sequencing the exome, and calling alleles from the sequence data, plus a health care
# encounter with a diagnosis and a prescription.
# Instance-level rendering of the graph on the 2019 poster
# "TURBO: Transforming and Unifying Research with Biomedical Ontologies",
# https://github.com/PennTURBO/Turbo-Documentation/blob/master/IBI_CIC_TURBO_MAM_20190102.pdf
#
# Every individual below is a made-up example; every class and property is an OBI term
# or a term OBI imports. Labels on individuals are for readers only.
#
# Issue: https://github.com/obi-ontology/obi/issues/1886

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix ex:   <http://example.org/obi-example/exome-sequencing/> .

<http://example.org/obi-example/exome-sequencing> a owl:Ontology ;
    owl:imports <http://purl.obolibrary.org/obo/obi.owl> .

ex:patient1 a owl:NamedIndividual, obo:NCBITaxon_9606 ;          # Homo sapiens
    rdfs:label "patient 1" ;
    obo:RO_0000087 ex:patient_role1,                              # has role
        ex:participant_under_investigation_role1 .

ex:patient_role1 a owl:NamedIndividual, obo:OBI_0000093 ;        # patient role
    rdfs:label "patient role 1" .

ex:participant_under_investigation_role1 a owl:NamedIndividual, obo:OBI_0000097 ;  # participant under investigation role
    rdfs:label "participant under investigation role 1" .

ex:specimen_collection1 a owl:NamedIndividual, obo:OBI_0000659 ; # specimen collection process
    rdfs:label "specimen collection 1" ;
    obo:OBI_0000293 ex:patient1 ;                                 # has specified input
    obo:OBI_0000299 ex:specimen1 .                                # has specified output

ex:specimen1 a owl:NamedIndividual, obo:OBI_0001479 ;            # specimen from organism
    rdfs:label "specimen 1" .

ex:dna_extraction1 a owl:NamedIndividual, obo:OBI_0000257 ;      # DNA extraction
    rdfs:label "DNA extraction 1" ;
    obo:OBI_0000293 ex:specimen1 ;                                # has specified input
    obo:OBI_0000299 ex:dna_extract1 .                             # has specified output

ex:dna_extract1 a owl:NamedIndividual, obo:OBI_0001051 ;         # DNA extract
    rdfs:label "DNA extract 1" .

ex:exome_sequencing1 a owl:NamedIndividual, obo:OBI_0002118 ;    # exome sequencing assay
    rdfs:label "exome sequencing 1" ;
    obo:OBI_0000293 ex:dna_extract1 ;                             # has specified input
    obo:OBI_0000299 ex:sequence_data1 .                           # has specified output

ex:sequence_data1 a owl:NamedIndividual, obo:OBI_0001573 ;       # DNA sequence data
    rdfs:label "DNA sequence data 1" .

# --- Biobank encounter ------------------------------------------------------------
# OBI says a 'participant under investigation role' is realized only in a
# 'study design execution', so the biobank encounter is typed as one.
ex:biobank_encounter1 a owl:NamedIndividual, obo:OBI_0000471 ;   # study design execution
    rdfs:label "biobank encounter 1" ;
    obo:RO_0000057 ex:patient1 .                                  # has participant

ex:specimen_collection1 obo:BFO_0000050 ex:biobank_encounter1 .   # part of
ex:participant_under_investigation_role1 obo:BFO_0000054 ex:biobank_encounter1 .  # realized in

# --- Health care encounter ----------------------------------------------------------
# OBI has no health care encounter class. OGMS has one, 'health care encounter'
# (OGMS:0000097), and it fits this individual. It is not used here because OBI does
# not import it, so using it would mean importing OGMS into the examples, and because
# OGMS places it under 'planned process' (OBI:0000011), which OBI has made obsolete.
# The encounter is typed with the class that replaced it, 'completely executed
# planned process'. Its outputs are a diagnosis and a prescription.
ex:health_care_encounter1 a owl:NamedIndividual, obo:COB_0000035 ;  # completely executed planned process
    rdfs:label "health care encounter 1" ;
    obo:RO_0000057 ex:patient1 ;                                  # has participant
    obo:OBI_0000299 ex:diagnosis1, ex:prescription1 .             # has specified output

ex:patient_role1 obo:BFO_0000054 ex:health_care_encounter1 .      # realized in

ex:diagnosis1 a owl:NamedIndividual, obo:OGMS_0000073 ;          # diagnosis
    rdfs:label "diagnosis 1: ICD10 I21.9" .

# OBI has no prescription class. The Prescription of Drugs Ontology (PDRO) has
# 'drug prescription' (PDRO:0000024), a kind of 'health care prescription'
# (PDRO:0000001), and it fits this individual. It is not used here because OBI does
# not import PDRO. PDRO places prescriptions under IAO 'document', which OBI does
# import, so the prescription is typed as a document.
ex:prescription1 a owl:NamedIndividual, obo:IAO_0000310 ;        # document
    rdfs:label "prescription 1: Plavix 300 mg PO tabs" .

# --- From sequence data to allele information -------------------------------------------
ex:loss_of_function_calling1 a owl:NamedIndividual, obo:OBI_0200000 ;  # data transformation
    rdfs:label "loss of function calling 1" ;
    obo:OBI_0000293 ex:sequence_data1 ;                           # has specified input
    obo:OBI_0000299 ex:allele_information1 .                      # has specified output

ex:genotype_information1 a owl:NamedIndividual, obo:OBI_0001305 ;  # genotype information
    rdfs:label "genotype information 1" ;
    obo:IAO_0000136 ex:patient1 .                                 # is about

ex:allele_information1 a owl:NamedIndividual, obo:OBI_0001352 ;  # allele information
    rdfs:label "CYP2C19 *2 allele information 1" ;
    obo:BFO_0000050 ex:genotype_information1 .                    # part of
